# Application
APP_NAME=NetLog AI
APP_ENV=development
LOG_LEVEL=INFO

# Database (MySQL 8 in production/Docker; SQLite supported for local tests)
DATABASE_URL=mysql+pymysql://netlog:netlog_password@mysql:3306/netlog_ai

# Security (required header X-API-Key on write endpoints)
API_KEY=change-me-in-production
MAX_UPLOAD_SIZE_BYTES=10485760
UPLOAD_RATE_LIMIT_REQUESTS=30
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60

# LLM Provider: "mock" (default, no API key required) or "openai"
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# Anomaly Detection Thresholds
RULE_FAILED_LOGIN_THRESHOLD=8
RULE_FAILED_LOGIN_WINDOW_MINUTES=5
RULE_HTTP_5XX_RATE_THRESHOLD=0.15
RULE_HTTP_5XX_MIN_REQUESTS=10
RULE_REPEATED_ERROR_THRESHOLD=10
RULE_REPEATED_ERROR_WINDOW_MINUTES=5
ML_CONTAMINATION=0.05
ML_MIN_BASELINE_MINUTES=10
ML_BASELINE_FRACTION=0.5
ML_RANDOM_STATE=42
